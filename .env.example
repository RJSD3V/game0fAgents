# Anthropic API key (for LangGraph quorum sensing agent)
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse tracing (auto-provisioned by docker compose — these work out of the box)
LANGFUSE_PUBLIC_KEY=pk-lf-symbiosis-local
LANGFUSE_SECRET_KEY=sk-lf-symbiosis-local
LANGFUSE_HOST=http://localhost:3000

# ClickHouse (shared instance — Langfuse traces + Symbiosis telemetry)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
